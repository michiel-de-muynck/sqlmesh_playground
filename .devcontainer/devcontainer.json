// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "SQLMesh",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",
	"customizations": {
		"vscode": {
			"settings": {
				"sqltools.connections": [
					{
						"previewLimit": 50,
						"server": "db",
						"port": 5432,
						"driver": "PostgreSQL",
						"name": "postgres",
						"database": "postgres",
						"username": "postgres",
						"password": "postgres"
					}
				],
				"sqltools.codelensLanguages": [],
				"sqltools.completionLanguages": [],
				"python.defaultInterpreterPath": "/opt/sqlmesh_venv/bin/python",
				"sqlmesh.lspEntrypoint": "/opt/sqlmesh_venv/bin/sqlmesh_lsp",
				"jupyter.askForKernelRestart": false,
				"python.terminal.activateEnvironment": true,
				"python.terminal.activateEnvInCurrentTerminal": true,
				"python.terminal.shellIntegration.enabled": true,
				"terminal.integrated.shellIntegration.enabled": true
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"mtxr.sqltools-driver-pg",
				"mtxr.sqltools",
				"tobikodata.sqlmesh",
				"ms-azuretools.vscode-containers",
				"ms-toolsai.jupyter"
			]
		}
	},
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:/home/vscode/.duckdb/cli/latest"
	},
	// More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode",
	// Enable docker CLI command to get postgres logs
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.6.5": {}
	},
	"containerEnv": {
		// Can't use a too-new Docker API version if using docker-outside-of-docker
		"DOCKER_API_VERSION": "1.43"
	}
}